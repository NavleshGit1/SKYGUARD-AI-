# Secrets — NEVER commit these to version control
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.env.local
.env.*.local
.venv

# Data (large raw files and local db)
data/raw/*.csv
!data/raw/.gitkeep
data/processed/*.csv
!data/processed/.gitkeep
data/*.db
models/*
!models/.gitkeep
!models/autoencoder.pt
!models/isolation_forest.pkl
!models/scaler.pkl

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
*.log

# Docker
.docker/

# Documentation (Only keep README.md tracked)
*.md
!README.md

