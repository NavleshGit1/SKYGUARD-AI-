# =============================================================================
# SkyGuard AI Frontend — Environment Configuration for Vercel / Production
# =============================================================================

# 1. Render Backend REST API Base URL
# Example: https://skyguard-backend.onrender.com
VITE_API_BASE_URL=https://skyguard-backend.onrender.com

# 2. Render WebSocket URL (Optional — auto-derived from VITE_API_BASE_URL if omitted)
# Example: wss://skyguard-backend.onrender.com/api/v1/ws/live-feed
VITE_WS_BASE_URL=wss://skyguard-backend.onrender.com/api/v1/ws/live-feed
