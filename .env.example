# =============================================================================
# SkyGuard AI — Environment Variables EXAMPLE
# Copy this to .env and fill in all values before running the project.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ── JWT & HMAC Security ──────────────────────────────────────────────────────
# REQUIRED — Generate fresh values, never reuse these placeholders
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
TELEMETRY_HMAC_SECRET=<generate: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong_random_password>
POSTGRES_DB=skyguard_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=<set_if_redis_has_auth>
